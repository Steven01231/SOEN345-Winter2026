<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/color_surface"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="16dp"
    android:elevation="3dp"
    android:orientation="vertical">

    <!-- Event image with category badge -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:background="@color/color_divider">

        <ImageView
            android:id="@+id/ivEventImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="Event image" />

        <LinearLayout
            android:id="@+id/llCategoryBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:background="@drawable/bg_admin_btn"
            android:paddingVertical="5dp"
            android:paddingHorizontal="14dp"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tvCategory"
                android:textColor="@color/color_admin"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="Category" />
        </LinearLayout>
    </FrameLayout>

    <!-- Event details -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:textColor="@color/color_text_primary"
            android:textSize="17sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="Event Title" />

        <!-- Date row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_calendar"
                android:tint="@color/color_admin"
                android:scaleType="fitXY"
                android:contentDescription="Date" />

            <TextView
                android:id="@+id/tvDate"
                android:textColor="@color/color_text_secondary"
                android:textSize="13sp"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="Date" />
        </LinearLayout>

        <!-- Location row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_location"
                android:tint="@color/color_admin"
                android:scaleType="fitXY"
                android:contentDescription="Location" />

            <TextView
                android:id="@+id/tvLocation"
                android:textColor="@color/color_text_secondary"
                android:textSize="13sp"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="Location" />
        </LinearLayout>

        <!-- Seats -->
        <TextView
            android:id="@+id/tvSeats"
            android:textColor="@color/color_success"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:layout_marginBottom="14dp"
            android:text="Available seats" />

        <!-- Action buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnEdit"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_outline_btn"
                android:text="Edit"
                android:textAllCaps="false"
                android:textColor="@color/color_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_danger_btn"
                android:text="Cancel"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:stateListAnimator="@null" />

        </LinearLayout>
    </LinearLayout>

</LinearLayout>
