<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/color_background">

    <!-- Toolbar -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:paddingTop="28dp"
        android:paddingBottom="4dp"
        android:background="@color/color_primary"
        android:elevation="4dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ibtnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_arrow_back"
            android:background="@drawable/bg_icon_button"
            android:scaleType="center"
            android:padding="10dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="4dp"
            android:tint="#FFFFFF"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Profile"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Avatar banner -->
            <LinearLayout
                android:id="@+id/avatarBanner"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:background="@color/color_primary"
                android:gravity="center"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:gravity="center"
                    android:background="@drawable/bg_profile_circle_blue"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvAvatarInitial"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="?"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF" />
                </LinearLayout>
            </LinearLayout>

            <!-- Form card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/color_surface"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingTop="28dp"
                android:paddingBottom="32dp">

                <TextView
                    style="@style/LabelStyle"
                    android:layout_marginTop="0dp"
                    android:text="Full Name" />

                <EditText
                    android:id="@+id/etFullName"
                    style="@style/InputStyle"
                    android:layout_marginBottom="4dp"
                    android:inputType="textPersonName"
                    android:hint="Your full name" />

                <TextView
                    style="@style/LabelStyle"
                    android:text="Email" />

                <!-- Email read-only -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_info_section"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:layout_marginBottom="32dp">

                    <TextView
                        android:id="@+id/tvEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/color_text_secondary"
                        android:textSize="15sp"
                        android:hint="Email address" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnSave"
                    style="@style/ButtonStyle.Primary"
                    android:layout_width="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:paddingHorizontal="40dp"
                    android:text="Save Changes"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btnLogout"
                    style="@style/ButtonStyle.Outline"
                    android:layout_width="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:paddingHorizontal="32dp"
                    android:text="Sign Out" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</LinearLayout>
